{
  "schema": "spatial-transformer-legal-pretrain-config-v1",
  "model": {
    "hidden_size": 96,
    "layers": 2,
    "attention_heads": 4,
    "feedforward_size": 384,
    "dropout": 0.1
  },
  "training": {
    "batch_size": 512,
    "epochs": 6,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "warmup_steps": 1000,
    "minimum_learning_rate_ratio": 0.1,
    "pass_fraction": 0.02,
    "num_workers": 4,
    "seed": 42,
    "mixed_precision": true,
    "d4_audit_samples": 4096
  },
  "validation_gates": {
    "exact_legal_set_accuracy": 0.9995,
    "f1": 0.9999,
    "illegal_cell_false_positive_rate": 0.00001,
    "pass_exact_legal_set_accuracy": 1.0,
    "d4_mask_consistency": 1.0,
    "role_mask_consistency": 1.0
  }
}
